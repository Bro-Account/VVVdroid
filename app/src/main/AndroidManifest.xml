<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Catalog files are opened in place, wherever they are stored
         (possibly multi-GB files that must not be copied into app storage). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- only meaningful up to Android 12; Android 13+ uses "All files access" -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:label="VVVdroid"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.VVVdroid">

        <!-- Configuration changes are handled by the activity: recreating it
             would drop the live Firebird attachment (and interrupt a catalog
             copy into app storage) while the engine still holds the file. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open a catalog from a file manager ("Open with"). Real paths
                 (file://, or content:// from the externalstorage provider) are
                 opened where they are; providers that only hand out a stream
                 (sync/cloud apps) are copied into app storage first. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:pathPattern=".*\\.vvv" />
                <data android:scheme="content" android:pathPattern=".*\\.vvv" />
            </intent-filter>

            <!-- Many file managers and sync apps report .vvv as generic binary
                 data without the extension in the provider path. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="content" android:mimeType="application/x-vvv-catalog" />
            </intent-filter>
        </activity>
    </application>
</manifest>
